{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIXIWYG",
  "version": "1.1.0-rc.1",
  "identifier": "app.pixiwyg.desktop",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Paint under it. Style on top of it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../index.html": "index.html",
      "../lib/": "lib/",
      "../examples/": "examples/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1"
        ]
      }
    }
  }
}
